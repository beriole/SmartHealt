# ============================================
# SmartHealth - Variables d'environnement
# Copier ce fichier en .env puis renseigner les valeurs
# ============================================

# Base de données PostgreSQL
DATABASE_URL=postgresql://user:password@localhost:5432/smarthealth

# JWT (OBLIGATOIRE en production : minimum 32 caractères aléatoires)
JWT_SECRET=changez-moi-secret-de-32-caracteres-minimum
JWT_EXPIRES_IN=7d
# Durée de vie de l'access token (court). Le refresh token prend le relais.
JWT_ACCESS_EXPIRES=1h
# Durée de vie du refresh token, en jours
REFRESH_EXPIRES_DAYS=30

# Serveur
PORT=3000
NODE_ENV=development

# URL du frontend (liens dans les emails)
FRONTEND_URL=http://localhost:3000

# Email (Gmail : utiliser un "mot de passe d'application")
EMAIL=votre-email@gmail.com
PASS_EMAIL=mot-de-passe-application
EMAIL_SENDER_NAME=SmartHealth

# Paiement Fapshi - Direct Pay (https://fapshi.com)
# Sandbox : https://sandbox.fapshi.com  |  Production : https://live.fapshi.com
FAPSHI_BASE_URL=https://sandbox.fapshi.com
FAPSHI_API_USER=votre-api-user
FAPSHI_API_KEY=votre-api-key
# Secret du webhook (en-tête x-wh-secret), configuré sur le dashboard Fapshi
FAPSHI_WEBHOOK_SECRET=

# Intelligence Artificielle - Groq (clé gratuite : https://console.groq.com)
GROQ_API_KEY=gsk_xxxx
# Modèle optionnel (défaut : llama-3.3-70b-versatile)
# GROQ_MODEL=llama-3.3-70b-versatile

# Microservice ML interne (modèles entraînés maison) — optionnel
# Si absent ou éteint, l'IA bascule automatiquement sur le LLM seul
ML_SERVICE_URL=http://127.0.0.1:8001
